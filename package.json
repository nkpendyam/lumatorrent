    "dag:v13": "node scripts/v13-implementation-dag.mjs",
    "verify:v14": "node scripts/verify-v14-final.mjs",
    "audit:v14": "node scripts/audit-v14-final.mjs",
    "final:readiness": "node scripts/final-readiness-v14.mjs",
    "codex:final": "node scripts/codex-final-command-center.mjs",
    "gap:final": "node scripts/final-gap-report-v14.mjs"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.7.0"
  }
