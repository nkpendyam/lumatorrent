    "github:init": "node scripts/github-init-repo.mjs",
    "github:labels": "node scripts/github-apply-labels.mjs",
    "github:milestones": "node scripts/github-create-milestones.mjs",
    "github:issues": "node scripts/github-create-backlog-issues.mjs",
    "github:rules": "node scripts/github-apply-ruleset.mjs",
    "github:secrets:check": "node scripts/github-secrets-check.mjs",
