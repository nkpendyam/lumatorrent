    "verify:v12": "node scripts/verify-v12-final-scaffold.mjs",
    "audit:v12": "node scripts/audit-v12-package.mjs",
    "gap:v12": "node scripts/v12-gap-report.mjs",
    "codex:context": "node scripts/codex-context-pack.mjs",
    "codex:next-milestone": "node scripts/codex-next-milestone.mjs",
    "github:project:plan": "node scripts/github-project-plan.mjs",
