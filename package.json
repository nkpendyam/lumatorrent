    "bench:scenarios": "node scripts/generate-benchmark-scenarios.mjs",
    "verify:v10": "node scripts/verify-v10-production-execution.mjs",
    "audit:v10": "node scripts/audit-v10-package.mjs",
    "preflight:prod": "node scripts/full-production-preflight.mjs",
