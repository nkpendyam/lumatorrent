{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EngineEvent",
  "type": "object",
  "required": ["type", "timestamp", "sequence"],
  "properties": {
    "type": {
      "enum": [
        "torrent.added",
        "torrent.metadata",
        "torrent.progress",
        "torrent.completed",
        "torrent.paused",
        "torrent.error",
        "engine.restarted",
        "engine.health",
        "engine.crashed",
        "diagnostic.updated"
      ]
    },
    "timestamp": {
      "type": "string"
    },
    "sequence": {
      "type": "number"
    },
    "torrentId": {
      "type": "string"
    },
    "payload": {
      "type": "object"
    }
  }
}
